{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Evidence-linked investment research commentary",
  "type":"object","required":["sections"],"additionalProperties":false,
  "properties":{"sections":{"type":"array","items":{
    "type":"object","required":["section","title","text","evidence_ids"],"additionalProperties":false,
    "properties":{
      "section":{"enum":["summary","comparison","portfolio"]},
      "title":{"type":"string","minLength":1},
      "text":{"type":"string","minLength":1},
      "evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^F[0-9]{3,}$"}}
    }
  }}}
}
