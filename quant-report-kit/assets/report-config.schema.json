{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Investment backtest report request v2",
  "type":"object",
  "required":["schema_version","title","strategies"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},
    "title":{"type":"string","minLength":1},
    "alignment":{"const":"common"},
    "start":{"type":"string","format":"date"},
    "end":{"type":"string","format":"date"},
    "report":{
      "type":"object","additionalProperties":false,
      "properties":{
        "document_type":{"const":"investment_backtest"},
        "version":{"type":"string","minLength":1},
        "report_date":{"type":"string","format":"date"},
        "report_id":{"type":"string","minLength":1},
        "issuer":{"type":"string","minLength":1},
        "author":{"type":"string","minLength":1},
        "reviewer":{"type":"string","minLength":1},
        "distribution":{"type":"string","minLength":1},
        "conflicts_disclosure":{"type":"string","minLength":1}
      }
    },
    "strategies":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","required":["id","label","result_dir"],"additionalProperties":false,
        "properties":{
          "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
          "label":{"type":"string","minLength":1},
          "result_dir":{"type":"string","minLength":1},
          "scenario":{"enum":["strategy","equal_weight","static","benchmark"]},
          "display":{"type":"object","additionalProperties":false,"properties":{
            "sleeves":{"type":"object","additionalProperties":{"type":"string","minLength":1}},
            "states":{"type":"object","additionalProperties":{"type":"string","minLength":1}}
          }}
        }
      }
    }
  }
}
