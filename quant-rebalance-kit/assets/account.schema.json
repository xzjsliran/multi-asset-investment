{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "account.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "actual",
        "simulation"
      ]
    },
    "position_policy": {
      "const": "long_only"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sleeve": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "available_quantity": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "sleeve",
          "code",
          "quantity",
          "available_quantity"
        ]
      }
    },
    "cash": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sleeve": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "sleeve",
          "currency",
          "amount"
        ]
      }
    },
    "strategy_state": {
      "type": "object"
    },
    "open_orders": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schema_version",
    "source",
    "as_of",
    "positions",
    "cash"
  ]
}
