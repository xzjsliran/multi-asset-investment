              {
                "series": "cn_pmi",
                "op": "<",
                "threshold": 50
              },
              {
                "series": "cn_cpi_yoy",
                "op": "<=",
                "threshold": 0,
                "transform": "change",
                "periods": 1
              }
            ],
            "changes": {
              "cn_equity": -0.04,
              "cn_bonds": 0.04
