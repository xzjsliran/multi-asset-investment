{
  "schema_version": 1,
  "name": "增长与通胀四状态配置策略",
  "start": "2025-01-01",
  "end": "2025-12-31",
  "base_currency": "CNY",
  "initial_capital": 1000000,
  "cost_rate": 0,
  "allocation_rebalance": "quarterly",
  "max_valuation_gap": 10,
  "benchmark": {
    "code": "510300.SH",
    "name": "沪深300ETF",
    "kind": "etf"
  },
  "macro": {
    "enabled": true,
    "rebalance": "monthly",
    "missing": "base_weights",
    "rules": [
      {
        "name": "增长较强、通胀上升",
        "all": [
          {
            "series": "cn_pmi",
            "op": ">=",
            "threshold": 50,
            "max_age_days": 62
          },
          {
            "series": "cn_cpi_yoy",
            "transform": "change",
            "periods": 1,
            "op": ">=",
            "threshold": 0,
            "max_age_days": 62
          }
        ],
        "weights": {
          "bond": 0.3,
          "equity": 0.3,
          "gold": 0.1,
          "commodity": 0.2,
          "stocks": 0.1
        }
      },
      {
        "name": "增长较强、通胀回落",
        "all": [
          {
            "series": "cn_pmi",
            "op": ">=",
            "threshold": 50,
            "max_age_days": 62
          },
          {
            "series": "cn_cpi_yoy",
            "transform": "change",
            "periods": 1,
            "op": "<",
            "threshold": 0,
            "max_age_days": 62
          }
        ],
        "weights": {
          "bond": 0.4,
          "equity": 0.35,
          "gold": 0.1,
          "commodity": 0.05,
          "stocks": 0.1
        }
      },
      {
        "name": "增长偏弱、通胀上升",
        "all": [
          {
            "series": "cn_pmi",
            "op": "<",
            "threshold": 50,
            "max_age_days": 62
          },
          {
            "series": "cn_cpi_yoy",
            "transform": "change",
            "periods": 1,
            "op": ">=",
            "threshold": 0,
            "max_age_days": 62
          }
        ],
        "weights": {
          "bond": 0.45,
          "equity": 0.1,
          "gold": 0.25,
          "commodity": 0.15,
          "stocks": 0.05
        }
      },
      {
        "name": "增长偏弱、通胀回落",
        "all": [
          {
            "series": "cn_pmi",
            "op": "<",
            "threshold": 50,
            "max_age_days": 62
          },
          {
            "series": "cn_cpi_yoy",
            "transform": "change",
            "periods": 1,
            "op": "<",
            "threshold": 0,
            "max_age_days": 62
          }
        ],
        "weights": {
          "bond": 0.6,
          "equity": 0.15,
          "gold": 0.15,
          "commodity": 0.05,
          "stocks": 0.05
        }
      }
    ]
  },
